@@ -164,11 +179,11 @@ Item {
   }
 
   function cellStyle(glyph, slot, bold) {
-    var key = glyph * 16 + slot * 2 + bold
+    var key = (glyph * 256 + slot) * 2 + bold
     var style = styleCache[key]
