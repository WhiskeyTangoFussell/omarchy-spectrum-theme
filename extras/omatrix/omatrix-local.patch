From 56faba0e37686989d6974f6e717a9aa6c0c80b87 Mon Sep 17 00:00:00 2001
From: fussell <dhfussell@gmail.com>
Date: Sat, 10 Oct 2026 15:44:37 -0400
Subject: [PATCH 4/4] Add tail_hue_shift; keep each stream's colour under
 positional tails

- tail_hue_shift (0..12, default 0 = off): from head to tail end each
  stream sweeps forward through that many tail colours (tail_colors order,
  wrapping), blended in eighths by the shader (colour byte bits 5..7,
  new tailCount uniform)
- fix (from tail_fade): groups[j] only tracks a column's newest stream, so
  with every cell re-rendered each tick an older stream recoloured when a
  new one started above it. Cells now record their stream's group at write
  time (inherited from the cell above)
- tests: hue sweep stays within [0, shift] and moves away from the head;
  cells keep their stream colour across re-renders (fails without the fix)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 MatrixScreen.qml        |  15 ++++++-
 Service.qml             |   1 +
 cmatrix.js              |  84 ++++++++++++++++++++++++++++++----------
 settings.js             |   2 +
 shaders/matrix.frag     |  11 +++++-
 shaders/matrix.frag.qsb | Bin 4666 -> 5138 bytes
 tests/engine.test.js    |  60 +++++++++++++++++++++++++++-
 7 files changed, 148 insertions(+), 25 deletions(-)

diff --git a/MatrixScreen.qml b/MatrixScreen.qml
index 6307ac2..b11b17b 100644
--- a/MatrixScreen.qml
+++ b/MatrixScreen.qml
@@ -48,6 +48,15 @@ Item {
   // 0..1: how far each tail dims from just behind the head to its oldest
   // cell (0 = off, every glyph at full colour).
   property real tailFade: 0
+  // How many tail colours (in tail_colors order, wrapping) each stream
+  // sweeps through from its head to its oldest cell, blended smoothly.
+  // 0 = off. Works best with one shade per group, listed in hue order.
+  property real tailHueShift: 0
+  readonly property int tailColorCount: {
+    var n = 0
+    for (var g = 0; g < tailGroups.length; g++) n += tailGroups[g].length
+    return Math.max(1, n)
+  }
 
   // "wake": every time the screen becomes visible it starts as an empty
   // terminal that fills up, like launching cmatrix. "full": start mid-run.
@@ -120,7 +129,8 @@ Item {
     lambda: lambda,
     charset: charset,
     tailGroups: tailGroups,
-    tailFade: tailFade
+    tailFade: tailFade,
+    tailHueShift: tailHueShift
   })
 
   property var engine: null
@@ -164,7 +174,7 @@ Item {
     // those take the full path (paintCell still skips unchanged cells);
     // otherwise only the handful of cells cmatrix wrote are re-rendered,
     // like ncurses updating a terminal.
-    if (options.rainbow || options.oldstyle || options.tailFade > 0 || fullRender
+    if (options.rainbow || options.oldstyle || options.tailFade > 0 || options.tailHueShift > 0 || fullRender
         || touchedCount + engine.dirtyCount > touched.length) {
       CMatrix.render(engine, options, frame)
       fullRender = true
@@ -367,6 +377,7 @@ Item {
     property matrix4x4 paletteC: root.paletteMatrix(8)
     property matrix4x4 paletteD: root.paletteMatrix(12)
     property matrix4x4 paletteE: root.paletteMatrix(16)
+    property real tailCount: root.tailColorCount
     property var stateTex: stateCanvas
     property var atlasTex: atlasCanvas
 
diff --git a/Service.qml b/Service.qml
index 78d4630..cefb0db 100644
--- a/Service.qml
+++ b/Service.qml
