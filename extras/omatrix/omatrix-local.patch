From 0dee4892f96da44837a8c5ad3962c8333abaf5e3 Mon Sep 17 00:00:00 2001
From: fussell <dhfussell@gmail.com>
Date: Sat, 10 Oct 2026 14:48:08 -0400
Subject: [PATCH 2/4] Expose tailGroups and find a cloned omarchy.lock

- lockService resolves through pluginRegistry.resolveEnabledId, so the
  wallpaper rain still pauses when omarchy.lock has been cloned
- tailGroups is a service property so the lock clone can reuse it

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Service.qml | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/Service.qml b/Service.qml
index 91606ed..16aca9c 100644
--- a/Service.qml
+++ b/Service.qml
@@ -65,6 +65,8 @@ Item {
     urgent: String(Color.urgent)
   })
   readonly property var palette: Settings.palette(config, themeColors, shellFallbacks)
+  // Shared with the lock screen clone, which draws its own MatrixScreen.
+  readonly property var tailGroups: Settings.tailGroups(config.tailColors)
 
   // The layer is opaque in the theme's terminal background colour, so the
   // compositor blends nothing and the wallpaper beneath is fully occluded.
@@ -72,7 +74,14 @@ Item {
 
   // --------------------------------------------------------- pause logic
 
-  readonly property var lockService: shell && shell.serviceFor ? shell.serviceFor("omarchy.lock") : null
+  // The built-in lock, or the user clone that replaced it
+  // (`omarchy plugin clone omarchy.lock`).
+  readonly property var lockService: {
+    if (!shell || !shell.serviceFor) return null
+    var registry = shell.pluginRegistry
+    var id = registry && registry.resolveEnabledId ? registry.resolveEnabledId("omarchy.lock") : "omarchy.lock"
+    return shell.serviceFor(id) || shell.serviceFor("omarchy.lock")
+  }
   readonly property bool locked: config.pauseWhenLocked && !!(lockService && lockService.locked)
   readonly property bool onBattery: UPower.onBattery
   readonly property bool batteryPaused: onBattery && config.onBattery === "pause"
@@ -217,7 +226,7 @@ Item {
         oldstyle: root.config.oldstyle
         rainbow: root.config.rainbow
         justifyColumns: root.config.justifyColumns
-        tailGroups: Settings.tailGroups(root.config.tailColors)
+        tailGroups: root.tailGroups
         start: root.config.start
         wakeSerial: root.wakeSerial
         rainOpacity: root.config.opacity
-- 
2.56.0


From 8b4dcb8d259c6a4e0be4ffedb78659eba410a313 Mon Sep 17 00:00:00 2001
From: fussell <dhfussell@gmail.com>
Date: Sat, 10 Oct 2026 15:33:31 -0400
Subject: [PATCH 3/4] Add tail_fade: per-stream brightness gradient

- tail_fade (0..1, default 0 = off): each stream is brightest just behind
  its head and dims linearly toward the layer behind it, to (1 - tail_fade)
  at its oldest glyph
- engine tracks per-column update counts and per-cell write times, so a
  cell's distance behind its head survives the head leaving the screen
- fade level packed into bits 1..5 of the frame's bold byte; shader scales
  alpha by it. With a fade, shades are a hash of the cell (no flicker on
  the per-tick full render)
- tests for fade monotonicity, head brightness, stable shades, and
  unchanged frames when the fade is off

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 MatrixScreen.qml        |  20 ++++++++-----
 Service.qml             |   1 +
 cmatrix.js              |  63 +++++++++++++++++++++++++++++++++++++---
 settings.js             |   2 ++
 shaders/matrix.frag     |   8 +++--
 shaders/matrix.frag.qsb | Bin 4383 -> 4666 bytes
 tests/engine.test.js    |  48 ++++++++++++++++++++++++++++++
 7 files changed, 129 insertions(+), 13 deletions(-)

diff --git a/MatrixScreen.qml b/MatrixScreen.qml
index ba407e0..6307ac2 100644
--- a/MatrixScreen.qml
+++ b/MatrixScreen.qml
@@ -45,6 +45,9 @@ Item {
   // Tail colour groups as palette slot numbers (settings.tailGroups); empty
   // for cmatrix's single -C colour.
   property var tailGroups: []
+  // 0..1: how far each tail dims from just behind the head to its oldest
