diff --git a/settings.js b/settings.js
index 365bb8a..d3d4cce 100644
--- a/settings.js
+++ b/settings.js
@@ -14,7 +14,9 @@ var DEFAULTS = {
   changes: false,
   oldstyle: false,
   rainbow: false,
+  justify_columns: false,
   color: "green",
+  tail_colors: "",
   head_color: "white",
   opacity: 1.0,
   backdrop_opacity: 0.0,
@@ -102,7 +104,8 @@ function resolveColor(themeColors, value, fallbackName, fallbacks) {
 function palette(settings, themeColors, fallbacks) {
   // Accepts either a merged (snake_case) or a resolved (camelCase) object.
   var head = settings.headColor !== undefined ? settings.headColor : settings.head_color
-  return [
+  var tails = settings.tailColors !== undefined ? settings.tailColors : tailColors(settings.tail_colors)
+  var out = [
     resolveColor(themeColors, head, "white", fallbacks),
     resolveColor(themeColors, settings.color, "green", fallbacks),
     ansi(themeColors, "green", fallbacks),
@@ -112,6 +115,10 @@ function palette(settings, themeColors, fallbacks) {
     ansi(themeColors, "cyan", fallbacks),
     ansi(themeColors, "magenta", fallbacks)
   ]
+  for (var i = 0; i < tails.length; i++) {
+    for (var k = 0; k < tails[i].length; k++) out.push(resolveColor(themeColors, tails[i][k], "green", fallbacks))
+  }
+  return out
 }
 
 function boldLevel(value) {
@@ -120,11 +127,48 @@ function boldLevel(value) {
   return 0
 }
 
+// Palette slots 8.. hold the tail colours; the shader has 20 slots in all.
+var TAIL_SLOT = 8
+var MAX_TAIL_COLORS = 12
+
+// tail_colors: hue groups separated by "|", shades within a group by ",".
+// Each stream picks one group and each of its glyphs a random shade from it,
+// e.g. "#f8d,#f2b,#b07 | #d9f,#b4f,#70d". Empty means the single `color`.
+function tailColors(value) {
+  var groups = []
+  var total = 0
+  var parts = String(value === undefined || value === null ? "" : value).split("|")
+  for (var i = 0; i < parts.length; i++) {
+    var group = []
+    var shades = parts[i].split(",")
+    for (var k = 0; k < shades.length && total < MAX_TAIL_COLORS; k++) {
+      var shade = shades[k].trim()
+      if (!shade) continue
+      group.push(shade)
+      total++
+    }
+    if (group.length > 0) groups.push(group)
+  }
+  return groups
+}
+
+// The engine's view of tailColors: the same groups as palette slot numbers.
+function tailGroups(groups) {
+  var out = []
+  var slot = TAIL_SLOT
+  for (var i = 0; i < (groups || []).length; i++) {
+    var group = []
+    for (var k = 0; k < groups[i].length; k++) group.push(slot++)
+    out.push(group)
+  }
+  return out
+}
+
 // Everything the renderer needs, typed and clamped.
 function resolve(userSettings, themeSettings) {
   var s = merge(userSettings, themeSettings)
   return {
-    updateDelay: Math.round(number(s.update_delay, 4, 0, 10)),
+    updateDelay: number(s.update_delay, 4, 0, 10),
     asynchronous: bool(s.asynchronous, false),
     boldLevel: boldLevel(s.bold),
     charset: oneOf(s.charset, ["ascii", "katakana", "console"], "ascii"),
@@ -132,7 +176,9 @@ function resolve(userSettings, themeSettings) {
     changes: bool(s.changes, false),
     oldstyle: bool(s.oldstyle, false),
     rainbow: bool(s.rainbow, false),
+    justifyColumns: bool(s.justify_columns, false),
     color: s.color,
+    tailColors: tailColors(s.tail_colors),
     headColor: s.head_color,
     opacity: number(s.opacity, 1, 0, 1),
     backdropOpacity: number(s.backdrop_opacity, 0, 0, 1),
@@ -144,7 +190,7 @@ function resolve(userSettings, themeSettings) {
     pauseWhenCovered: bool(s.pause_when_covered, true),
     pauseWhenLocked: bool(s.pause_when_locked, true),
     onBattery: oneOf(s.on_battery, ["slow", "pause", "ignore"], "slow"),
-    batteryUpdateDelay: Math.round(number(s.battery_update_delay, 6, 0, 10)),
+    batteryUpdateDelay: number(s.battery_update_delay, 6, 0, 10),
     raw: s
   }
 }
diff --git a/shaders/matrix.frag b/shaders/matrix.frag
index b7406af..bcadbf0 100644
--- a/shaders/matrix.frag
+++ b/shaders/matrix.frag
@@ -19,34 +19,52 @@ layout(std140, binding = 0) uniform buf {
     float atlasColumns;   // glyph slots per atlas row
     float atlasRows;      // rows per weight (regular, then bold below)
     float glyphCount;     // number of valid glyph indices
+    float columnStride;   // distance between the left edges of drawn (even) columns
     mat4 paletteA;        // palette slots 0..3, one color per column
     mat4 paletteB;        // palette slots 4..7
+    mat4 paletteC;        // palette slots 8..11 (tail colours)
+    mat4 paletteD;        // palette slots 12..15
+    mat4 paletteE;        // palette slots 16..19
 };
 
 layout(binding = 1) uniform sampler2D stateTex;
 layout(binding = 2) uniform sampler2D atlasTex;
 
 vec4 paletteColor(int slot) {
-    if (slot == 0) return paletteA[0];
-    if (slot == 1) return paletteA[1];
-    if (slot == 2) return paletteA[2];
-    if (slot == 3) return paletteA[3];
-    if (slot == 4) return paletteB[0];
-    if (slot == 5) return paletteB[1];
-    if (slot == 6) return paletteB[2];
-    return paletteB[3];
+    if (slot < 4) return paletteA[slot];
+    if (slot < 8) return paletteB[slot - 4];
+    if (slot < 12) return paletteC[slot - 8];
+    if (slot < 16) return paletteD[slot - 12];
+    return paletteE[min(slot, 19) - 16];
 }
 
 void main() {
     vec2 px = qt_TexCoord0 * itemSize;
     vec2 cell = floor(px / cellSize);
 
+    // cmatrix only draws even columns. Place them every columnStride pixels
+    // (2 cells for a terminal grid, wider when justified to the screen
+    // edges); anything between a column's glyph and the next is empty.
+    float column = floor(px.x / columnStride);
+    if (px.x - column * columnStride >= cellSize.x) {
+        fragColor = vec4(0.0);
+        return;
+    }
+    cell.x = column * 2.0;
+
     if (cell.x < 0.0 || cell.y < 0.0 || cell.x >= gridSize.x || cell.y >= gridSize.y) {
         fragColor = vec4(0.0);
         return;
     }
 
     vec4 state = texture(stateTex, (cell + 0.5) / gridSize);
+    // Painted cells are opaque; a transparent texel is canvas the grid never
+    // covered (fractional scaling rounds the backing image up a row), which
+    // would otherwise decode as glyph 0, a row of white '!'.
+    if (state.a < 0.5) {
+        fragColor = vec4(0.0);
+        return;
+    }
     float glyph = floor(state.r * 255.0 + 0.5);
     if (glyph >= glyphCount) {
         fragColor = vec4(0.0);
@@ -60,7 +78,7 @@ void main() {
     float atlasCol = glyph - atlasRow * atlasColumns;
     atlasRow += bold * atlasRows;
 
-    vec2 local = px - cell * cellSize;
+    vec2 local = vec2(px.x - column * columnStride, px.y - cell.y * cellSize.y);
     vec2 atlasPx = vec2(atlasCol, atlasRow) * cellSize + local;
     float coverage = texture(atlasTex, atlasPx / atlasSize).a;
 
